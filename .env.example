# Canonical URL of the site. Used for metadata, sitemap, RSS, and OG images.
# Locally you can leave this unset — it falls back to http://localhost:3000.
# On Vercel, set it to your production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Optional. If set, the contact form sends mail via Resend (https://resend.com).
# If unset, the contact section degrades to a plain mailto: link — no signup needed.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
